{
  "name": "@synai/core",
  "version": "1.3.0",
  "description": "Core Agent Engine, OpenRouter Client and Tool Pipeline for SynAI",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "type": "module",
  "scripts": {
    "build": "tsc && node --input-type=module -e \"import fs from 'node:fs'; fs.cpSync('src/prompts/templates', 'dist/prompts/templates', { recursive: true, force: true });\"",
    "dev": "tsc --watch",
    "clean": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\"",
    "test": "npm run build && node --test test/*.test.js"
  },
  "dependencies": {
    "diff": "^7.0.0",
    "dotenv": "^16.4.7",
    "puppeteer-core": "^25.10.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/diff": "^7.0.0",
    "@types/node": "^22.10.2",
    "@types/ws": "^8.5.13",
    "typescript": "^5.7.2"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/synai/synai.git"
  },
  "homepage": "https://github.com/synai/synai#readme",
  "bugs": {
    "url": "https://github.com/synai/synai/issues"
  },
  "author": "SynAI Contributors",
  "license": "MIT"
}
