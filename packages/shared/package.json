{
  "name": "@synai/shared",
  "version": "1.3.0",
  "description": "Shared types, schemas and utilities for SynAI",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./storage": {
      "types": "./dist/storage/index.d.ts",
      "import": "./dist/storage/index.js"
    }
  },
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/synai/synai.git",
    "directory": "packages/shared"
  },
  "homepage": "https://github.com/synai/synai#readme",
  "bugs": {
    "url": "https://github.com/synai/synai/issues"
  },
  "keywords": [
    "synai",
    "ai",
    "shared",
    "types",
    "utilities"
  ],
  "author": "SynAI Contributors",
  "license": "MIT"
}
