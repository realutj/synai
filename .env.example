# OpenRouter API Key (Optional for free models, required for higher rate limits)
# Get a free key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Default Model (Defaults to auto-detected best free model like qwen/qwen-2.5-coder-32b-instruct:free)
OPENROUTER_DEFAULT_MODEL=qwen/qwen-2.5-coder-32b-instruct:free

# Approval Mode: auto | confirm | dry-run
SYNAI_APPROVAL_MODE=confirm

# Web UI Server Port
SYNAI_PORT=4242
SYNAI_HOST=localhost
